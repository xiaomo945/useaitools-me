# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# GSC credentials
credentials.json


# temp
/.tmp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local sqlite databases (regenerate with: npx prisma db push && npx tsx prisma/seed-sponsored.ts)
*.db
*.db-journal
*.db-wal
*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# agent memory / automation run logs (local only, never commit)
.workbuddy-ai/

# Local content-audit scratch files
_*.mjs
_*.txt
_*.cjs
_*.md
_*.html
_rewrite/
